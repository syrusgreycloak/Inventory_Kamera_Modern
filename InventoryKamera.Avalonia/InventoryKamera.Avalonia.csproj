<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-targeted: net8.0 for cross-platform base; net8.0-windows for Windows runtime.
         Infrastructure reference is TFM-scoped to net8.0-windows (see ItemGroup below).
         Chunk 9 adds platform stubs for the net8.0 TFM. -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>InventoryKamera.Avalonia</RootNamespace>
    <AssemblyName>InventoryKamera.Avalonia</AssemblyName>
    <ApplicationIcon>..\InventoryKamera\Item_Special_Kamera.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Define WINDOWS preprocessor symbol for the Windows TFM so DI registration
       of platform-specific types can be gated at compile time. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="MsBox.Avalonia" Version="3.0.0-rc2" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="Octokit" Version="13.0.1" />
    <ProjectReference Include="..\InventoryKamera.Core\InventoryKamera.Core.csproj" />
    <!-- Infrastructure is Windows-only: scoped to net8.0-windows TFM.
         Chunk 9 adds non-Windows stubs so the net8.0 TFM still resolves platform services. -->
    <ProjectReference Include="..\InventoryKamera.Infrastructure\InventoryKamera.Infrastructure.csproj" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\InventoryKamera\inventorylists\**\*" Link="inventorylists\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\InventoryKamera\tessdata\**\*" Link="tessdata\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
