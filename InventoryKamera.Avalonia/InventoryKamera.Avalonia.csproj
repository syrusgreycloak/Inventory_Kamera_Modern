<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-targeted: net8.0 for cross-platform base; net8.0-windows for Windows runtime.
         Infrastructure reference is TFM-scoped to net8.0-windows (see ItemGroup below).
         Chunk 9 adds platform stubs for the net8.0 TFM. -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>InventoryKamera.Avalonia</RootNamespace>
    <AssemblyName>InventoryKamera.Avalonia</AssemblyName>
    <ApplicationIcon>Item_Special_Kamera.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Inventory Kamera Modern</AssemblyTitle>
    <!-- AssemblyVersion and FileVersion follow Version; the release workflow sets it from the tag -->
    <Version>2.0.0</Version>
  </PropertyGroup>
  <!-- Define WINDOWS preprocessor symbol for the Windows TFM so DI registration
       of platform-specific types can be gated at compile time. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="MsBox.Avalonia" Version="3.0.0-rc2" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="Octokit" Version="13.0.1" />
    <ProjectReference Include="..\InventoryKamera.Core\InventoryKamera.Core.csproj" />
    <!-- Infrastructure is Windows-only: scoped to net8.0-windows TFM.
         Chunk 9 adds non-Windows stubs so the net8.0 TFM still resolves platform services. -->
    <ProjectReference Include="..\InventoryKamera.Infrastructure\InventoryKamera.Infrastructure.csproj" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Data files committed in reference_data/: game data (characters/weapons/artifacts/materials
         JSON and version.txt, refreshable at runtime via the About tab's "Update game data"),
         ScanProfile.json and stat_priorities.json. Linked into the inventorylists/ output folder,
         where DatabaseManager and the scan runner look for them. -->
    <None Include="..\reference_data\*.json" Link="inventorylists\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\reference_data\version.txt" Link="inventorylists\version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\tessdata\*.traineddata" Link="tessdata\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup>
    <!-- English only: the app's UI is English, and the bundled Windows desktop runtime would
         otherwise add translated error messages for 13 languages (cs, de, ... zh-Hant folders) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The OCR package copies its 32-bit native libraries too; a win-x64 publish never uses them -->
  <Target Name="RemoveUnusedX86OcrLibraries" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)x86" />
  </Target>
</Project>
