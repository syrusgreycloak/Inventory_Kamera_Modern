<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:InventoryKamera.Avalonia.Controls"
             x:Class="InventoryKamera.Avalonia.Views.SettingsView">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

    <!-- Padding moved off ScrollViewer to the inner panel: ensures ScrollViewer's
         content-height measurement is correct and the bottom row scrolls fully into view. -->
    <StackPanel Orientation="Vertical"
                Spacing="16"
                MaxWidth="640"
                HorizontalAlignment="Stretch"
                Margin="16,16,16,32">

      <!-- First start, or no output folder: what to set before scanning -->
      <Border Classes="panel" Padding="16" IsVisible="{Binding NeedsSetup}"
              BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Text="Before your first scan"
                     FontWeight="Bold"
                     FontSize="14" />
          <TextBlock TextWrapping="Wrap"
                     Text="• Choose an output folder. Scans aren't saved without one." />
          <TextBlock TextWrapping="Wrap"
                     Text="• Enter your Traveler's name, and the Wanderer's name if you renamed him (under Names). A blank Traveler name is read from the game." />
          <TextBlock TextWrapping="Wrap"
                     Text="• If you changed the game's inventory (B), character (C) or first-slot (1) keys, set them under Hotkeys." />
        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════
           OUTPUT
      ══════════════════════════════════════════════════ -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">

          <TextBlock Text="Output"
                     FontWeight="Bold"
                     FontSize="14"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <TextBlock Text="Output folder"
                     FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Margin="0,0,8,0"
                     Text="{Binding OutputPath, Mode=TwoWay}"
                     Watermark="(select a folder…)"
                     Background="{StaticResource PrimaryBgBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     Padding="8,4" />
            <Button Grid.Column="1"
                    Content="Browse…"
                    Command="{Binding BrowseOutputPathCommand}" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════
           NAMES
      ══════════════════════════════════════════════════ -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">

          <TextBlock Text="Names"
                     FontWeight="Bold"
                     FontSize="14"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <!-- Traveler name -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Traveler name"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <TextBox Grid.Column="1"
                     Text="{Binding TravelerName, Mode=TwoWay}"
                     Watermark="(leave blank to auto-detect)"
                     Background="{StaticResource PrimaryBgBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     Padding="8,4" />
          </Grid>

          <!-- Wanderer name -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Wanderer name"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <TextBox Grid.Column="1"
                     Text="{Binding WandererName, Mode=TwoWay}"
                     Watermark="wanderer"
                     Background="{StaticResource PrimaryBgBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     Padding="8,4" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════
           ITEM FILTERS
      ══════════════════════════════════════════════════ -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">

          <TextBlock Text="Item Filters"
                     FontWeight="Bold"
                     FontSize="14"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <!-- Weapon rarity -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Min. weapon rarity"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding MinimumWeaponRarity, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="5"
                           Increment="1"
                           FormatString="0"
                           Background="{StaticResource PrimaryBgBrush}"
                           BorderThickness="1" />
          </Grid>

          <!-- Weapon level -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Min. weapon level"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding MinimumWeaponLevel, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="90"
                           Increment="1"
                           FormatString="0"
                           Background="{StaticResource PrimaryBgBrush}"
                           BorderThickness="1" />
          </Grid>

          <!-- Artifact rarity -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Min. artifact rarity"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding MinimumArtifactRarity, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="5"
                           Increment="1"
                           FormatString="0"
                           Background="{StaticResource PrimaryBgBrush}"
                           BorderThickness="1" />
          </Grid>

          <!-- Artifact level -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Min. artifact level"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding MinimumArtifactLevel, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="20"
                           Increment="1"
                           FormatString="0"
                           Background="{StaticResource PrimaryBgBrush}"
                           BorderThickness="1" />
          </Grid>

          <Separator />

          <CheckBox Content="Update equipped weapons during scan"
                    IsChecked="{Binding EquipWeapons, Mode=TwoWay}" />
          <CheckBox Content="Update equipped artifacts during scan"
                    IsChecked="{Binding EquipArtifacts, Mode=TwoWay}" />

        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════
           HOTKEYS
      ══════════════════════════════════════════════════ -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">

          <TextBlock Text="Hotkeys"
                     FontWeight="Bold"
                     FontSize="14"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <TextBlock Text="Click a key box, then press the desired key to rebind."
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <!-- Inventory key -->
          <Grid ColumnDefinitions="160,*">
            <TextBlock Grid.Column="0"
                       Text="Inventory key"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <ctrl:KeyBindingCapture Grid.Column="1"
                                    KeyValue="{Binding InventoryKey, Mode=TwoWay}"
                                    HorizontalAlignment="Left" />
          </Grid>

          <!-- Character key -->
          <Grid ColumnDefinitions="160,*">
            <TextBlock Grid.Column="0"
                       Text="Character key"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <ctrl:KeyBindingCapture Grid.Column="1"
                                    KeyValue="{Binding CharacterKey, Mode=TwoWay}"
                                    HorizontalAlignment="Left" />
          </Grid>

          <!-- Slot 1 key -->
          <Grid ColumnDefinitions="160,*">
            <TextBlock Grid.Column="0"
                       Text="Slot 1 key"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <ctrl:KeyBindingCapture Grid.Column="1"
                                    KeyValue="{Binding Slot1Key, Mode=TwoWay}"
                                    HorizontalAlignment="Left" />
          </Grid>

        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════
           ADVANCED
      ══════════════════════════════════════════════════ -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">

          <TextBlock Text="Advanced"
                     FontWeight="Bold"
                     FontSize="14"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <!-- Scanner delay -->
          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Scanner delay (ms)"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding ScannerDelay, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="5000"
                           Increment="50"
                           FormatString="0"
                           Background="{StaticResource PrimaryBgBrush}"
                           BorderThickness="1" />
          </Grid>

          <Separator />

          <!-- Game data source: where "Update game data" downloads from. Configurable so a repository
               move (AnimeGameData -> animegamedata2 at 6.6) doesn't need a code change. -->
          <TextBlock Text="Game data source"
                     FontSize="12"
                     FontWeight="SemiBold" />

          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Repository URL (GitLab/GitHub)"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <TextBox Grid.Column="1"
                     Text="{Binding GameDataRepoUrl, Mode=TwoWay}"
                     Watermark="https://gitlab.com/Dimbreath/animegamedata2"
                     ToolTip.Tip="GitLab or GitHub repository laid out like Dimbreath's game data (ExcelBinOutput/, TextMap/). Paste the URL from your browser."
                     Background="{StaticResource PrimaryBgBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     Padding="8,4" />
          </Grid>

          <Grid ColumnDefinitions="200,*">
            <TextBlock Grid.Column="0"
                       Text="Branch"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <TextBox Grid.Column="1"
                     Text="{Binding GameDataBranch, Mode=TwoWay}"
                     Watermark="main"
                     Background="{StaticResource PrimaryBgBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     Padding="8,4" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="200,0,0,0">
            <Button Content="Test"
                    Command="{Binding TestGameDataSourceCommand}"
                    ToolTip.Tip="Check the repository is reachable and show the latest game version in it." />
            <Button Content="Reset to default"
                    Command="{Binding ResetGameDataSourceCommand}"
                    ToolTip.Tip="Use Dimbreath/animegamedata2 on branch main." />
          </StackPanel>

          <TextBlock Text="{Binding GameDataSourceStatus}"
                     IsVisible="{Binding GameDataSourceStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Margin="200,0,0,0"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <Separator />

          <!-- Diagnostic logging: dumps every captured region to logging/<category>/.
               Useful for diagnosing OCR misreads; produces hundreds of PNGs per scan. -->
          <CheckBox Content="Log all scan screenshots (diagnostics)"
                    IsChecked="{Binding LogScreenshots, Mode=TwoWay}"
                    ToolTip.Tip="Saves every captured weapon/artifact/material region to logging/&lt;category&gt;/. Use to inspect what the OCR engine saw on misreads. Off by default — generates lots of files." />

          <!-- Last update check -->
          <TextBlock FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}">
            <Run Text="Last update check: " />
            <Run Text="{Binding LastUpdateCheck, StringFormat='yyyy-MM-dd HH:mm'}" />
          </TextBlock>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
