<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InventoryKamera.Avalonia.ViewModels"
        xmlns:views="clr-namespace:InventoryKamera.Avalonia.Views"
        x:Class="InventoryKamera.Avalonia.Views.MainWindow"
        Title="Inventory Kamera"
        Width="960" Height="780"
        MinWidth="720" MinHeight="520">

    <Window.KeyBindings>
        <!-- Stop the running scan with Escape or Enter once focus returns to this window
             (typically via Alt+Tab while the scanner has the cursor in Genshin).
             CanExecute on StopScanCommand means these are no-ops outside an active scan. -->
        <KeyBinding Gesture="Escape" Command="{Binding ScanVm.StopScanCommand}" />
        <KeyBinding Gesture="Enter"  Command="{Binding ScanVm.StopScanCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.DataTemplates>

    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Scan" Content="{Binding ScanVm}" />
        <TabItem Header="Settings" Content="{Binding SettingsVm}" />
        <TabItem Header="Export" Content="{Binding ExportVm}" />
        <TabItem Header="About" Content="{Binding AboutVm}" />
    </TabControl>
</Window>
