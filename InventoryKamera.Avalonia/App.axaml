             x:Class="InventoryKamera.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://InventoryKamera.Avalonia/Assets/Styles/GenshinTheme.axaml" />
    </Application.Styles>
</Application>
